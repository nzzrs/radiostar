<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release traffic must be HTTPS. The embedding server is reached through
         Cloudflare Tunnel or a trusted reverse proxy. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
